# PS 47 — Environment variables
# Copy this file to .env and fill in real values before running.

# ── Database ────────────────────────────────────────────────────────────────
# For local development with PostgreSQL:
DATABASE_URL=postgresql://ps47user:ps47pass@localhost:5432/ps47db

# For running tests without PostgreSQL (SQLite, auto-used by conftest.py):
# Set TEST_DATABASE_URL in tests/conftest.py — do not override here.

# ── JWT ─────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_ME_generate_a_real_secret_before_use
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── App ─────────────────────────────────────────────────────────────────────
APP_ENV=development
APP_VERSION=0.1.0-phase1

# ── Document storage ─────────────────────────────────────────────────────────
# Local filesystem path for uploaded document scans (created on startup if missing)
UPLOAD_DIR=uploads

# ── OCR Provider ─────────────────────────────────────────────────────────────
# Options: paddleocr (default, zero-cost local OCR) | google_vision
OCR_PROVIDER=paddleocr

# ── Google Cloud Vision OCR ──────────────────────────────────────────────────
# Path to service account JSON key file (used if OCR_PROVIDER=google_vision)
GOOGLE_APPLICATION_CREDENTIALS=./credentials/google-ocr.json

# ── LLM Provider (Phase 4B) ──────────────────────────────────────────────────
# Primary provider: openai | Alternatives: gemini | anthropic
# LLM_PROVIDER=openai
#
# Model identifier (provider-specific):
#   openai:    gpt-4o-mini (recommended, low cost)  |  gpt-4o
#   gemini:    gemini-2.0-flash  |  gemini-1.5-pro
#   anthropic: claude-3-haiku-20240307  |  claude-3-5-sonnet-20241022
# LLM_MODEL=gpt-4o-mini
#
# API key for the chosen provider (required — never commit real keys):
# LLM_API_KEY=sk-...your-key-here...
#
# Optional: override base URL for OpenAI-compatible endpoints (e.g. Ollama, LM Studio):
# LLM_BASE_URL=http://localhost:11434/v1

# ── ASR / Speech-to-Text Provider (Phase 4C) ─────────────────────────────────
# Primary provider: gemini
ASR_PROVIDER=gemini
# Model identifier:
#   gemini: gemini-3.5-transcribe (recommended, dedicated ASR) | gemini-3.8-flash
ASR_MODEL=gemini-3.5-transcribe
ASR_LANGUAGE_MODE=auto
# Optional: override ASR API key if distinct from LLM_API_KEY:
# ASR_API_KEY=...

# ── Google OAuth 2.0 / OpenID Connect (Phase 2D) ─────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
